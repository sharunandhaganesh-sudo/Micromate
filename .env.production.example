# ==============================================================================
# Microclimate Production Environment Configuration Example
# ==============================================================================

# Core Application
APP_NAME=Microclimate
APP_ENV=production
DEBUG=false
SECRET_KEY=change-this-to-a-secure-random-64-character-secret-in-production

# CORS Origins (Comma-separated production domains)
CORS_ORIGINS=https://your-domain.vercel.app,https://api.your-domain.com

# Database Connection (PostgreSQL for Production, SQLite for Local Testing)
# PostgreSQL Example: postgresql+psycopg2://user:password@hostname:5432/microclimate_prod
# SQLite Example: sqlite:///./microclimate.db
DATABASE_URL=sqlite:///./microclimate.db

# Default Station Configuration
DEFAULT_STATION_CODE=STN-001
DEFAULT_STATION_NAME=Ridgecrest Observatory
DEFAULT_DEVICE_ID=ESP32-WX-001

# ThingSpeak Cloud Integration (Option A)
# Get Channel ID and Read API Key from your ThingSpeak Channel Settings
THINGSPEAK_ENABLED=true
THINGSPEAK_CHANNEL_ID=3590932
THINGSPEAK_READ_API_KEY=your_read_api_key_here
THINGSPEAK_WRITE_API_KEY=
THINGSPEAK_SYNC_INTERVAL_SECONDS=20
THINGSPEAK_POLL_INTERVAL_SECONDS=15
THINGSPEAK_TIMEOUT_SECONDS=10

# Ingestion & Anomaly Limits
TELEMETRY_FRESHNESS_WINDOW_SECONDS=60
MAX_INGESTION_RATE_PER_MINUTE=120

# Notification Integrations (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
ALERT_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

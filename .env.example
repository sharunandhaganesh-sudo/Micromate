# AeroPulse Platform Environment Configuration
PROJECT_NAME="AeroPulse Microclimate & Extreme Weather Intelligence"
SECRET_KEY=aeropulse_super_secret_production_key_change_in_real_env_2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database: SQLite for local dev, PostgreSQL/TimescaleDB for production
DATABASE_URL=sqlite:///./microclimate.db
# DATABASE_URL=postgresql://aeropulse:secure_db_password_change_me@localhost:5432/microclimate

# MQTT Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_ENABLED=false
MQTT_TLS_ENABLED=false
MQTT_TOPIC_PREFIX=microclimate/v1

# Device Freshness Limits (in seconds)
DEVICE_STALE_THRESHOLD_SECONDS=120
DEVICE_OFFLINE_THRESHOLD_SECONDS=300

# Simulator
ENABLE_DEMO_SIMULATOR_BY_DEFAULT=true

# Optional External Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
TELEGRAM_BOT_TOKEN=
